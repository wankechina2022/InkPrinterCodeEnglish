<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- [2026-09-11] 万总确认客户现场为 Win7 SP1 x64，.NET 8 不支持 Win7（最低 Win10 1607），
         降到 .NET 6（支持 Win7 的最后一个 LTS）。代码经扫描确认零依赖 .NET 8 独有 API 与 C# 11/12 语法，
         Environment.TickCount64 为 .NET Core 3.0+ API，net6 原生支持 → 仅改本行，代码文件零改动。
         部署要求：目标机安装 .NET 6 Desktop Runtime (x64)。 -->
    <TargetFramework>net6.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- [2026-09-10] 第三方依赖（阶段二起不再使用 App.config 配置文件，参数存数据库 SystemConfig 表）
       Microsoft.Data.Sqlite：SQLite 数据访问，微软官方包，无需手动携带 native dll
       NPOI                ：Excel 读写（.xls / .xlsx 都支持），导入取第一列、导出用流式 SXSSF
       版本全部锁定在 8.0 线（[2026-09-11] 降 net6 后包不变：三个包均含 netstandard2.0/net6 目标，net6 直接可用；
       勿升 9.x/10.x）；NPOI 锁 2.7.5 稳定线
       [2026-09-10] 移除 System.Configuration.ConfigurationManager —— 配置文件已废弃（万总拍板：
       反写配置文件有格式损坏导致程序无法启动的历史事故，改为内置默认值 + SystemConfig 表双保险）
       [2026-09-10] 阶段二第 2 轮新增 System.IO.Ports —— .NET 8 里 SerialPort 不在共享框架内，
       串口连接（SerialPrinterConnection）必须显式引用此包，仍锁 8.0 线 -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.31" />
    <PackageReference Include="NPOI" Version="2.7.5" />
    <PackageReference Include="System.IO.Ports" Version="8.0.0" />
  </ItemGroup>

</Project>
