<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- [2026-09-11] Targeting .NET 6 — the last LTS with Windows 7 support (.NET 8 requires Win10 1607+).
         Code verified free of .NET 8-only APIs and C# 11/12 syntax; Environment.TickCount64 is a
         .NET Core 3.0+ API natively supported on net6.
         Requires .NET 6 Desktop Runtime (x64). -->
    <TargetFramework>net6.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- [2026-09-10] Third-party dependencies (since App.config is no longer used;
       all settings live in the database SystemConfig table)
       Microsoft.Data.Sqlite : SQLite data access, official Microsoft package, no manual native dll shipping needed
       NPOI                  : Excel read/write (.xls / .xlsx); import takes the first column, export uses streaming SXSSF
       Versions are locked to the 8.0 line ([2026-09-11] packages unchanged after the net6 downgrade:
       all three packages ship netstandard2.0/net6 targets, directly usable on net6;
       do NOT upgrade to 9.x/10.x); NPOI locked to the stable 2.7.5 line.
       [2026-09-10] Removed System.Configuration.ConfigurationManager — config files are deprecated
       (writing back to a config file previously caused format corruption that
       prevented the program from starting; replaced by built-in defaults + SystemConfig table as a
       safety net).
       [2026-09-10] System.IO.Ports was added later — on .NET 8 (and net6), SerialPort is not
       in the shared framework; the serial connection (SerialPrinterConnection) requires this
       explicit package reference, still locked to the 8.0 line. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.31" />
    <PackageReference Include="NPOI" Version="2.7.5" />
    <PackageReference Include="System.IO.Ports" Version="8.0.0" />
  </ItemGroup>

</Project>
